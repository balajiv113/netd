+/// Copy a TX descriptor chain (header + payload, any number of descriptors)
+/// into owned buffers. Returns `None` for malformed chains.
+fn gather_tx_chain<M, T>(
+    mem: &M,
+    chain: virtio_queue::DescriptorChain<T>,
+    max_data_size: u32,
+) -> Option<(Vec<u8>, Vec<u8>)>
+where
+    M: vm_memory::GuestMemory,
+    T: Deref,
+    T::Target: vm_memory::GuestMemory,
+{
+    use vm_memory::{Address, Bytes};
+    let mut hdr = vec![0u8; PKT_HEADER_SIZE];
+    let mut hdr_len = 0usize;
+    let mut data = Vec::new();
+    let mut want = None;
+    for desc in chain {
+        if desc.is_write_only() {
+            return None;
+        }
+        let mut addr = desc.addr();
+        let mut left = desc.len() as usize;
+        if hdr_len < PKT_HEADER_SIZE {
+            let n = left.min(PKT_HEADER_SIZE - hdr_len);
+            mem.read_slice(&mut hdr[hdr_len..hdr_len + n], addr).ok()?;
+            hdr_len += n;
+            left -= n;
+            addr = addr.checked_add(n as u64)?;
+            if hdr_len == PKT_HEADER_SIZE {
+                // virtio_vsock_hdr.len is a le32 at offset 24.
+                let len = u32::from_le_bytes(hdr[24..28].try_into().unwrap());
+                if len > max_data_size {
+                    return None;
+                }
+                want = Some(len as usize);
+                data.reserve_exact(len as usize);
+            }
+        }
+        if let Some(w) = want {
+            let n = left.min(w - data.len());
+            if n > 0 {
+                let start = data.len();
+                data.resize(start + n, 0);
+                mem.read_slice(&mut data[start..], addr).ok()?;
+            }
+        }
+    }
+    (want == Some(data.len())).then_some((hdr, data))
+}
