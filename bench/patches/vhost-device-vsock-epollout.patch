+    #[test]
+    fn test_gather_tx_chain_multi_descriptor() {
+        use virtio_bindings::bindings::virtio_ring::VRING_DESC_F_NEXT;
+        use virtio_queue::{
+            desc::{split::Descriptor as SplitDescriptor, RawDescriptor},
+            mock::MockSplitQueue,
+            Queue,
+        };
+        use vm_memory::{Address, Bytes};
+
+        let mem = GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 0x10000)]).unwrap();
+        let vq = MockSplitQueue::new(&mem, 16);
+        let payload: Vec<u8> = (0..300u32).map(|i| i as u8).collect();
+        let mut hdr = [0u8; PKT_HEADER_SIZE];
+        hdr[24..28].copy_from_slice(&(payload.len() as u32).to_le_bytes());
+
+        // Header split over two descriptors, payload over three of uneven size.
+        let mut stream = hdr.to_vec();
+        stream.extend_from_slice(&payload);
+        let sizes = [30usize, 20, 100, 1, 193];
+        let mut addr = 0x4000u64;
+        let mut off = 0;
+        for (i, len) in sizes.iter().enumerate() {
+            let last = i == sizes.len() - 1;
+            let flags = if last { 0 } else { VRING_DESC_F_NEXT as u16 };
+            let d = RawDescriptor::from(SplitDescriptor::new(addr, *len as u32, flags, i as u16 + 1));
+            mem.write(&stream[off..off + len], GuestAddress(addr)).unwrap();
+            vq.desc_table().store(i as u16, d).unwrap();
+            addr += 0x100;
+            off += len;
+        }
+        mem.write_obj(0u16, vq.avail_addr().unchecked_add(4)).unwrap();
+        mem.write_obj(1u16, vq.avail_addr().unchecked_add(2)).unwrap();
+        let atomic = GuestMemoryAtomic::new(mem.clone());
+        let guard = atomic.memory();
+        let mut q = vq.create_queue::<Queue>().unwrap();
+        let mut chain = q.iter(guard.clone()).unwrap().next().unwrap();
+        let copy = chain.clone();
+
+        // The stock parser rejects this layout...
+        VsockPacket::from_tx_virtq_chain(guard.deref(), &mut chain, 1 << 20).unwrap_err();
+        // ...the gather path reassembles it exactly.
+        let (h, d) = gather_tx_chain(guard.deref(), copy.clone(), 1 << 20).unwrap();
+        assert_eq!(h, hdr);
+        assert_eq!(d, payload);
+        // Oversized payloads are refused.
+        assert!(gather_tx_chain(guard.deref(), copy, 100).is_none());
+    }
